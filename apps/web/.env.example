# The dashboard's environment. Next reads apps/web/.env.local (or the Vercel
# project settings); it does NOT read the repo-root .env, which belongs to the
# API. Nothing here is secret — every NEXT_PUBLIC_* value is compiled into the
# browser bundle by definition.
#
# Both are inlined at BUILD time. Changing either on Vercel without
# redeploying changes nothing at all: the old value is already in the
# JavaScript that was shipped.

# Where the API lives. Unset, it falls back to http://localhost:8080, which is
# right for `pnpm dev` and wrong for every deployment — a Vercel screen with
# this unset subscribes to a bus on a laptop that is not running, so the
# transcript stays blank while /demo/metrics beside it shows real numbers.
NEXT_PUBLIC_API_URL=https://frontly.onrender.com

# Unlocks the demo screen's reset button. Must be byte-identical to the API's
# DEMO_RESET_TOKEN (Render generates that one; copy it across).
#
# This lands in the browser bundle, so it is a lock on the door, not a secret.
# The rule that actually protects production is in resetRefusal(): a process
# that is not production may only ever reset a file: database, whatever token
# it is shown. Leave this empty for local development.
NEXT_PUBLIC_DEMO_RESET_TOKEN=
