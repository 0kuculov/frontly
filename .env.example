# ─────────────────────────────────────────────────────────────
# Frontly — environment
# Copy to .env and fill in. Everything except DATABASE_URL is
# optional until the phase that needs it (see comments).
# Validated by packages/shared/src/env.ts (zod). The server
# refuses to boot on an invalid value rather than failing later.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info

# --- Phase 1: database -------------------------------------------------
# Local dev  : file:./frontly.db          (no auth token needed)
# Turso prod : libsql://<db>-<org>.turso.io + token
DATABASE_URL=file:./frontly.db
DATABASE_AUTH_TOKEN=

# Dashboard origin(s) allowed by CORS. Comma-separated.
APP_ORIGIN=http://localhost:3000

# Public https URL of THIS api (Render), e.g. https://frontly-api.onrender.com
# Optional until Phase 3: it is only used to build the media-stream URL handed
# to the carrier, and is required at boot once TELNYX_API_KEY is set.
PUBLIC_BASE_URL=

# --- Phase 2: LLM ------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Phase 3: telephony + speech --------------------------------------
# Telnyx. The API key is a Bearer token on every Call Control command.
TELNYX_API_KEY=
# E.164. The number callers dial, and the caller ID a transfer presents.
TELNYX_PHONE_NUMBER=
# Account Settings -> Keys & Credentials -> Public Key. Without it the webhook
# accepts unsigned requests, which production refuses to boot with.
TELNYX_PUBLIC_KEY=

AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=italynorth

# --- Phase 4: dashboard auth ------------------------------------------
# 32+ chars. Generate: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
AUTH_SECRET=

# --- Phase 6: SMS follow-up --------------------------------------------
# Who messages come from. THIS ONE VARIABLE is the switch between the two
# modes, and nothing else changes when it flips.
#
#   +16193497599  a number the account owns. Works to US handsets ONLY:
#                 Telnyx reports international_outbound: false for it, so a
#                 message to a +389 mobile is accepted and never delivered.
#                 The code refuses those up front rather than pretending.
#   FRONTLY       an alphanumeric sender ID. How the Balkans receive one-way
#                 notifications, needs no A2P 10DLC (that is US-domestic and
#                 would not have helped), and needs Telnyx to enable it per
#                 destination country — hence the open ticket for MK.
#
# Left unset, the code falls back to TELNYX_PHONE_NUMBER so a US handset can
# be tested against. Unset and with no Telnyx number, SMS is simply disabled:
# the phone is the product and a missing messaging profile must never stop a
# call being answered.
TELNYX_SMS_FROM=
# Required by Telnyx whenever TELNYX_SMS_FROM is alphanumeric — there is no
# number for it to look the profile up from. Setting one without the other
# fails at boot with the variable named.
TELNYX_MESSAGING_PROFILE_ID=

# --- Phase 7: demo mode ------------------------------------------------
# Guards the destructive "reset demo clinic" endpoint.
#
# Required in production, where POST /demo/reset otherwise lets anyone who
# guesses the path blank the stage numbers mid-pitch. Render generates it
# (render.yaml, generateValue: true); copy that value into the dashboard's
# NEXT_PUBLIC_DEMO_RESET_TOKEN on Vercel so the reset button keeps working.
#
# Not needed locally: a non-production server refuses to reset ANY database
# that is not a file: one, token or no token, because DATABASE_URL below
# usually points at the live Turso database.
DEMO_RESET_TOKEN=
