{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Write(.env)",
      "Edit(.env)",
      "Write(./.env)",
      "Edit(./.env)",
      "Write(**/.env)",
      "Edit(**/.env)",
      "Write(.env.local)",
      "Edit(.env.local)",
      "Write(.env.production)",
      "Edit(.env.production)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-env.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
