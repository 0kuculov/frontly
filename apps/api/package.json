{
  "name": "@frontly/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc -b",
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify:azure": "tsx scripts/verify-azure.ts",
    "simulate:call": "tsx scripts/simulate-call.ts",
    "check:numbers": "tsx scripts/check-phone-numbers.ts",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/formbody": "^8.0.2",
    "@fastify/sensible": "^6.0.3",
    "@fastify/websocket": "^11.3.0",
    "@frontly/core": "workspace:*",
    "@frontly/shared": "workspace:*",
    "microsoft-cognitiveservices-speech-sdk": "^1.51.0",
    "twilio": "^6.1.0",
    "fastify": "^5.12.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "drizzle-orm": "^0.45.2",
    "pino-pretty": "^13.1.2",
    "tsx": "^4.23.12",
    "typescript": "5.9.3",
    "vitest": "^4.1.11"
  }
}
